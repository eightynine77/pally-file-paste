
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Avalonia Android",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "pallyFilePaste.Android/pallyFilePaste.Android.csproj"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run Avalonia Desktop",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "pallyFilePaste.Desktop/pallyFilePaste.Desktop.csproj"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "build Avalonia for linux",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "build",
                "pallyFilePaste.Desktop/pallyFilePaste.Desktop.csproj",
                "-c",
                "Release",
                "-r", 
                "linux-x64"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Start android emulator",
            "type": "process",
            "command": "emulator",
            "args": [
                "@le-fon",
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}