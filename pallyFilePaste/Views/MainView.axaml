<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:pallyFilePaste.ViewModels"
             xmlns:views="clr-namespace:pallyFilePaste.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="pallyFilePaste.Views.MainView"
             xmlns:androidcontrols="using:pallyFilePaste"
             x:DataType="vm:MainViewModel">
    
    <UserControl.Resources>
        <StreamGeometry x:Key="OpenFolderIcon">F1 M121.35 118.09l260.64 0 0 -31.3c0.73,-7.76 -4.67,-9.69 -11.24,-9.98 -3.77,-0.18 -7.97,-0.2 -11.76,-0.01l-150.17 0c-36.03,0 -43.17,-19.04 -49.96,-37.13 -3.87,-10.32 -7.56,-20.17 -22.65,-20.17l-104.38 0c-6.76,0 -12.33,5.57 -12.33,12.33l0 253.04 61.44 -139.95c6.5,-14.82 24.13,-26.83 40.41,-26.83zm280.14 0l86.05 0c19.11,0 29.72,16.28 21.83,34.29l0.03 0.01 -73.77 168.06c-6.5,14.83 -24.14,26.83 -40.41,26.83l-366.19 0c-7.65,0 -13.84,-2.56 -18.08,-6.74 -6.2,-5.19 -10.95,-17.13 -10.95,-25.05l0 -283.66c0,-17.52 14.31,-31.83 31.83,-31.83l104.38 0c28.52,0 34.55,16.06 40.86,32.89 4.46,11.89 9.15,24.4 31.75,24.4 51.2,0 102.48,0.33 153.67,0.02 3.05,-0.03 6.18,-0.06 9.1,0.07 16.41,0.76 30.82,5.4 29.88,29.41l0.02 31.3zm85.97 19.05l-366.19 0c-8.66,0 -19,7.42 -22.44,15.25l-73.77 168.06 -0.03 -0.01c-2.05,4.68 -1.46,7.8 4.07,7.8l366.2 0c8.66,0 18.99,-7.43 22.43,-15.26l73.77 -168.06c0.07,0.03 4.09,-7.78 -4.04,-7.78z</StreamGeometry>
    </UserControl.Resources>

    <!-- Root Container wrapping all top-level controls -->
    <Grid>
        <SplitView x:Name="NavSplitView" 
                   IsPaneOpen="False" 
                   DisplayMode="Overlay"
                   OpenPaneLength="200"
                   PaneOpening="NavSplitView_PaneOpening"
                   PaneClosing="NavSplitView_PaneClosing">
            
            <!-- The Navigation Menu -->
            <SplitView.Pane>
                <StackPanel Spacing="10" Margin="10">
                    <TextBlock Text="Menu" FontWeight="Bold" FontSize="20" Margin="0,10,0,20"/>
        
                    <Button x:Name="NavHomeButton"
                            Content="Home" 
                            HorizontalAlignment="Stretch" 
                            Background="LightGray"
                            FontSize="18"
                            Click="NavHome_Click"/>
                
                    <Button x:Name="NavAboutButton"
                            Content="About" 
                            FontSize="18"
                            HorizontalAlignment="Stretch" 
                            Background="Transparent"
                            Click="NavAbout_Click"/>
                </StackPanel>
            </SplitView.Pane>
            
            <!-- The Main Content -->
            <SplitView.Content>
                <Grid x:Name="MainContentGrid" RowDefinitions="Auto,*">
                    
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0"
                                Content="☰"
                                FontSize="24"
                                Width="45"
                                Height="45"
                                Background="Transparent"
                                Click="HamburgerButton_Click"
                                Margin="5"/>

                        <Button Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="5"
                                Width="45"
                                Height="45"
                                Background="#53e336"
                                Click="OpenFolderButton_Click">
                            <svg:Svg x:Name="OpenFolderSvg"
                             Path="/Assets/openFolder.svg"
                             Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Your Existing Content -->
                    <ScrollViewer x:Name="HomeContentView"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Visible">
                        
                        <StackPanel Margin="20" Spacing="15">
                            
                            <Button x:Name="SinglePasteButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Height="150"
                                    Click="SinglePasteButton_Click">
                                <TextBlock Text="click here to paste into image"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="24" />
                            </Button>
                            
                            <TextBlock x:Name="SingleStatusText"
                                       Text="[status message]"
                                       Foreground="Red"
                                       TextWrapping="Wrap"
                                       IsVisible="False"/>

                            <TextBlock Text="paste in bulk" 
                                       FontSize="18"
                                       TextWrapping="Wrap"
                                       Margin="0, 20, 0, 0"/>
                            
                            <Grid MinHeight="200"
                                  RowDefinitions="200,180">
                                
                                <!-- Android native bulk input -->
                                <Border Grid.Row="0"
                                        IsVisible="{OnPlatform Default=False, Android=True}"
                                        Background="White"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <androidcontrols:AndroidBulkPasteTextBox
                                        x:Name="AndroidBulkPasteHost"
                                        MinHeight="200"/>
                                </Border>

                                <!-- Pasted image display -->
                                <ListBox x:Name="BulkPasteListBox"
                                     Grid.Row="1"
                                     MaxHeight="180"
                                     Margin="4"
                                     ScrollViewer.IsScrollChainingEnabled="True"
                                     Background="Transparent"
                                     BorderThickness="2"
                                     BorderBrush="#03AC13"
                                     CornerRadius="4"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="views:MainView+PastedImage">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4">
                                                <Image Grid.Column="0"
                                                       Source="{Binding Image}"
                                                       Width="40"
                                                       Height="40"
                                                       Stretch="UniformToFill"
                                                       Margin="0,0,10,0"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FileName}"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="2"
                                                        Content="X"
                                                        VerticalAlignment="Center"
                                                        Padding="8,4"
                                                        FontSize="20"
                                                        Background="Red"
                                                        Foreground="White"
                                                        Click="DiscardButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                
                                <TextBlock x:Name="BulkStatusText"
                                           Grid.Column="0"
                                           Text="[status message]"
                                           Foreground="Red"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           IsVisible="False"/>
                                
                                <Button x:Name="BulkSaveButton"
                                        Grid.Column="1"
                                        Width="100"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Click="BulkSaveButton_Click">
                                        <TextBlock Text="save"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="18" />
                                </Button>
                            </Grid>
                        </StackPanel>

                    </ScrollViewer>

                    <views:AboutPage x:Name="AboutContentView" Grid.Row="1" IsVisible="False"/>
                </Grid>
            </SplitView.Content>
        </SplitView>

        <!-- Permission Warning Overlay -->
        <Grid x:Name="PermissionOverlay" 
              Background="#A6000000" 
              IsVisible="False" 
              ZIndex="100">
            
            <Border Background="#242424"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="400"
                    Margin="20">
                
                <StackPanel Spacing="15" HorizontalAlignment="Center">
                    <TextBlock Text="WARNING" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="Red" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="You must allow this app's file storage permission in order for this app to work." 
                               TextWrapping="Wrap" 
                               TextAlignment="Center" 
                               FontSize="16" 
                               Foreground="White"/>
                    
                    <Button Content="allow" 
                            HorizontalAlignment="Center" 
                            HorizontalContentAlignment="Center"
                            Width="100"
                            Background="#03AC13" 
                            Foreground="White"
                            Click="AllowPermission_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>