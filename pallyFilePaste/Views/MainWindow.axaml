<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:pallyFilePaste.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:pallyFilePaste.Views"
        mc:Ignorable="d"
        x:Class="pallyFilePaste.Views.MainWindow"
        Width="950" 
        Height="500"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/PallyPasteFile_desktopIcon.ico"
        Title="pally file paste">
    <Window.Styles>
        <!-- Normal icon color -->
        <Style Selector="Button#OpenFolderButton :is(path)[id=openFolderPath]">
            <Setter Property="fill" Value="Black" />
        </Style>

        <!-- Normal button background -->
        <Style Selector="Button#OpenFolderButton">
            <Setter Property="Background" Value="#53e336" />
        </Style>

        <!-- Button background when hovering -->
        <Style Selector="Button#OpenFolderButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2E8B1E" />
        </Style>

        <!-- Button background while pressed -->
        <Style Selector="Button#OpenFolderButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2E8B1E" />
        </Style>

        <!-- Icon color while hover -->
        <Style Selector="Button#OpenFolderButton:pointerover :is(path)[id=openFolderPath]">
            <Setter Property="fill" Value="White" />
        </Style>

        <!-- Icon color while pressed -->
        <Style Selector="Button#OpenFolderButton:pressed :is(path)[id=openFolderPath]">
            <Setter Property="fill" Value="White" />
        </Style>

        <!-- Text color while hovering -->
        <Style Selector="Button#OpenFolderButton:pointerover TextBlock#openFolderText">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Text color while pressed -->
        <Style Selector="Button#OpenFolderButton:pressed TextBlock#openFolderText">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>
    <SplitView x:Name="NavSplitView" 
               IsPaneOpen="False" 
               DisplayMode="Overlay"
               OpenPaneLength="200">
        
        <!-- The Navigation Menu -->
        <SplitView.Pane>
            <StackPanel Spacing="10" Margin="10">
                <TextBlock Text="Menu" FontWeight="Bold" FontSize="20" Margin="0,10,0,20"/>
    
                <Button x:Name="NavHomeButton"
                        Content="Home" 
                        HorizontalAlignment="Stretch" 
                        Background="LightGray"
                        FontSize="15"
                        Click="NavHome_Click"/>
            
                <Button x:Name="NavAboutButton"
                        Content="About" 
                        FontSize="15"
                        HorizontalAlignment="Stretch" 
                        Background="Transparent"
                        Click="NavAbout_Click"/>
            </StackPanel>
        </SplitView.Pane>
        
        <!-- The Main Content -->
        <SplitView.Content>
            <Grid x:Name="MainContentGrid" RowDefinitions="Auto,*">
                
                <!-- Hamburger Button Header -->
                <Button Grid.Row="0" 
                        Content="☰" 
                        FontSize="20" 
                        Width="41" 
                        Height="41" 
                        Background="Transparent" 
                        Click="HamburgerButton_Click" 
                        Margin="3"/>
                
                <!-- Open Folder Button -->
                <Button Grid.Row="0"
                        FontSize="16"
                        x:Name="OpenFolderButton"
                        Height="41"
                        Click="OpenFolderButton_Click"
                        HorizontalAlignment="Right"
                        Margin="3"
                        VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <svg Width="22"
                             Height="22"
                             Stretch="Uniform"
                             viewBox="0 0 512 347.28">
                            <g>
                                <path id="openFolderPath"
                                      fill-rule="nonzero"
                                      d="M121.35 118.09l260.64 0 0 -31.3c0.73,-7.76 -4.67,-9.69 -11.24,-9.98 -3.77,-0.18 -7.97,-0.2 -11.76,-0.01l-150.17 0c-36.03,0 -43.17,-19.04 -49.96,-37.13 -3.87,-10.32 -7.56,-20.17 -22.65,-20.17l-104.38 0c-6.76,0 -12.33,5.57 -12.33,12.33l0 253.04 61.44 -139.95c6.5,-14.82 24.13,-26.83 40.41,-26.83zm280.14 0l86.05 0c19.11,0 29.72,16.28 21.83,34.29l0.03 0.01 -73.77 168.06c-6.5,14.83 -24.14,26.83 -40.41,26.83l-366.19 0c-7.65,0 -13.84,-2.56 -18.08,-6.74 -6.2,-5.19 -10.95,-17.13 -10.95,-25.05l0 -283.66c0,-17.52 14.31,-31.83 31.83,-31.83l104.38 0c28.52,0 34.55,16.06 40.86,32.89 4.46,11.89 9.15,24.4 31.75,24.4 51.2,0 102.48,0.33 153.67,0.02 3.05,-0.03 6.18,-0.06 9.1,0.07 16.41,0.76 30.82,5.4 29.88,29.41l0.02 31.3zm85.97 19.05l-366.19 0c-8.66,0 -19,7.42 -22.44 15.25l-73.77 168.06 -0.03 -0.01c-2.05,4.68 -1.46,7.8 4.07,7.8l366.2 0c8.66,0 18.99 -7.43 22.43 -15.26l73.77 -168.06c0.07,0.03 4.09,-7.78 -4.04,-7.78z"/>
                            </g>
                        </svg>

                        <TextBlock Text="open folder"
                                   FontSize="16"
                                   x:Name="openFolderText"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Home Content (Your Original Desktop Grid) -->
                <ScrollViewer x:Name="HomeContentView" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="True">
                    <Grid ColumnDefinitions="*, *" Margin="20" MinHeight="420">
                        
                        <!-- Left Side: Single Paste -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="20" Margin="10">
                            <Button x:Name="SinglePasteButton"
                                    HorizontalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Height="150"
                                    Click="SinglePasteButton_Click">
                                <TextBlock Text="click here to paste into image" TextWrapping="Wrap" TextAlignment="Center" FontSize="24" />
                            </Button>
                            <TextBlock x:Name="SingleStatusText" Text="[status message]" Foreground="Red" TextWrapping="Wrap" IsVisible="False"/>
                        </StackPanel>

                        <!-- Right Side: Bulk Paste -->
                        <Grid Grid.Column="1" RowDefinitions="Auto, *, *, Auto" Margin="10">
                            <TextBlock Grid.Row="0" Text="paste in bulk" FontSize="18" Margin="0, 0, 0, 10"/>
                            
                            <TextBox Grid.Row="1" x:Name="BulkPasteTextBox"
                                     MinHeight="100"
                                     PlaceholderText="Tap here to focus &amp; paste from clipboard..."
                                     PastingFromClipboard="BulkPasteTextBox_PastingFromClipboard"
                                     TextChanged="BulkPasteTextBox_TextChanged"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     BorderThickness="1" BorderBrush="Gray" CornerRadius="4"/>
                            
                            <ListBox Grid.Row="2" x:Name="BulkPasteListBox" Margin="0,10"
                                     Background="Transparent" BorderThickness="2" BorderBrush="#03AC13" CornerRadius="4"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="views:MainWindow+PastedImage">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4">
                                            <Image Grid.Column="0"
                                                   Source="{Binding Image}"
                                                   Width="40"
                                                   Height="40"
                                                   Stretch="UniformToFill"
                                                   Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FileName}"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="2"
                                                    Content="X"
                                                    VerticalAlignment="Center"
                                                    Padding="8,4"
                                                    FontSize="16"
                                                    Background="Red"
                                                    Foreground="White"
                                                    Click="DiscardButton_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
                                <TextBlock x:Name="BulkStatusText" Grid.Column="0" Text="[status message]" Foreground="Red" VerticalAlignment="Center" IsVisible="False" TextWrapping="Wrap" />
                                <Button x:Name="BulkSaveButton" Grid.Column="1" Width="100" HorizontalContentAlignment="Center" Click="BulkSaveButton_Click">
                                    <TextBlock Text="save" FontSize="18"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- About Page Content -->
                <views:AboutPage x:Name="AboutContentView" Grid.Row="1" IsVisible="False"/>
            </Grid>
        </SplitView.Content>
    </SplitView>
</Window>