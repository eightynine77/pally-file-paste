<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="pallyFilePaste.Views.AboutPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="pally file paste" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="2026.9.9 - v1.0.0" 
                       FontSize="22" 
                       TextWrapping="Wrap"
                       Foreground="Gray" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="A cross-platform app for pasting clipboard images in single files or bulk. available on windows, android, and linux" 
                       TextWrapping="Wrap" 
                       FontSize="18"
                       TextAlignment="Center" 
                       Margin="0,10,0,0"/>
            <HyperlinkButton NavigateUri="https://github.com/eightynine77"
                             Foreground="DodgerBlue"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="18"
                             Cursor="Hand"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center">
                <TextBlock Text="made by eightynine77 with love."
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </HyperlinkButton>
        </StackPanel>
    </ScrollViewer>
</UserControl>